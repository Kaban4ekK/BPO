using System;
using System.Collections.Generic;

public abstract class Animal
{
    protected string Name { get; set; }
    protected int Age { get; set; }

    protected Animal(string name, int age)
    {
        Name = name;
        Age = age;
        Console.WriteLine($"[Animal] Конструктор: {Name}");
    }

    ~Animal()
    {
        Console.WriteLine($"[Animal] Финализатор: {Name}");
    }

    public abstract void Talk();

    public virtual void Print()
    {
        Console.WriteLine($"  Имя: {Name}, Возраст: {Age} лет");
    }
}

public class Dog : Animal
{
    private string Breed { get; set; }

    public Dog(string name, int age, string breed) : base(name, age)
    {
        Breed = breed;
        Console.WriteLine($"[Dog] Конструктор: {Name}");
    }

    ~Dog()
    {
        Console.WriteLine($"[Dog] Финализатор: {Name}");
    }

    public override void Talk()
    {
        Console.WriteLine($"{Name} говорит: Гав-гав!");
    }

    public override void Print()
    {
        Console.WriteLine("Собака:");
        base.Print();
        Console.WriteLine($"  Порода: {Breed}");
    }
}

public class Cat : Animal
{
    private bool Fluffy { get; set; }

    public Cat(string name, int age, bool fluffy) : base(name, age)
    {
        Fluffy = fluffy;
        Console.WriteLine($"[Cat] Конструктор: {Name}");
    }

    ~Cat()
    {
        Console.WriteLine($"[Cat] Финализатор: {Name}");
    }

    public override void Talk()
    {
        Console.WriteLine($"{Name} говорит: Мяу!");
    }

    public override void Print()
    {
        Console.WriteLine("Кошка:");
        base.Print();
        Console.WriteLine($"  Пушистая: {(Fluffy ? "да" : "нет")}");
    }
}

public abstract class Artiodactyl : Animal
{
    protected int HoofCount { get; set; }

    protected Artiodactyl(string name, int age, int hoofCount) : base(name, age)
    {
        HoofCount = hoofCount;
        Console.WriteLine($"[Artiodactyl] Конструктор: {Name}");
    }

    ~Artiodactyl()
    {
        Console.WriteLine($"[Artiodactyl] Финализатор: {Name}");
    }


    public override void Print()
    {
        base.Print();
        Console.WriteLine($"  Количество копыт: {HoofCount}");
    }
}

public class Cow : Artiodactyl
{
    private double MilkPerDay { get; set; }

    public Cow(string name, int age, int hoofCount, double milkPerDay)
        : base(name, age, hoofCount)
    {
        MilkPerDay = milkPerDay;
        Console.WriteLine($"[Cow] Конструктор: {Name}");
    }

    ~Cow()
    {
        Console.WriteLine($"[Cow] Финализатор: {Name}");
    }

    public override void Talk()
    {
        Console.WriteLine($"{Name} говорит: Му-у-у!");
    }

    public override void Print()
    {
        Console.WriteLine("Корова:");
        base.Print();
        Console.WriteLine($"  Удой: {MilkPerDay} л/день");
    }
}

public class Horse : Artiodactyl
{
    private double MaxSpeed { get; set; }

    public Horse(string name, int age, int hoofCount, double maxSpeed)
        : base(name, age, hoofCount)
    {
        MaxSpeed = maxSpeed;
        Console.WriteLine($"[Horse] Конструктор: {Name}");
    }

    ~Horse()
    {
        Console.WriteLine($"[Horse] Финализатор: {Name}");
    }

    public override void Talk()
    {
        Console.WriteLine($"{Name} говорит: Иго-го!");
    }

    public override void Print()
    {
        Console.WriteLine("Лошадь:");
        base.Print();
        Console.WriteLine($"  Макс. скорость: {MaxSpeed} км/ч");
    }
}

public class Program
{
    public static void Main()
    {
        var zoo = new List<Animal>
        {
            new Dog("Рекс", 3, "Овчарка"),
            new Cat("Мурка", 2, true),
            new Cow("Бурёнка", 5, 4, 20.5),
            new Horse("Орлик", 7, 4, 60.0)
        };

        Console.WriteLine("\n========== Обход массива ==========");
        foreach (var animal in zoo)
        {
            animal.Talk();   // полиморфный вызов
            animal.Print();
            Console.WriteLine();
        }

        Console.WriteLine("========== Конец Main ==========");
        GC.Collect();
        GC.WaitForPendingFinalizers();
    }
}
